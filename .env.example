# Never commit .env. Use a NEW table; do not reuse sandbox records.
ORDINET_USER=
ORDINET_PASSWORD=
TOOL_API_KEY=
# Search credentials are runtime secrets, never Docker build arguments or image files.
AZURE_EMBEDDING_ENDPOINT=https://<resource>.services.ai.azure.com
AZURE_EMBEDDING_DEPLOYMENT=text-embedding-3-small
AZURE_EMBEDDING_KEY=
# Optional: required only for explicit mode=jev. Pinned Jev 1.13.0.
TYPESAFE_API_KEY=
RETURNS_ENABLED=false
# Set true ONLY after explicit authorization for real SOAP creation; default is fail-closed.
RETURN_SUBMISSION_ENABLED=false
RETURN_AZURE_AUTH=cli
RETURN_TABLE_ENDPOINT=https://<account>.table.core.windows.net
RETURN_TABLE_NAME=ReturnOperations
RETURN_HASH_KEY=
# Optional deployment restriction: leave BOTH empty for all eligible orders.
# Every operation independently verifies the customer's order/email via SOAP.
RETURN_ALLOWED_ORDER=
RETURN_ALLOWED_EMAIL=
